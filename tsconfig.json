{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "supabase",
    "app.bak",
    "components/scanner",
    "scripts/createPlayReviewAccount.ts",
    "scripts/createReviewerGrant.ts",
    "scripts/validateProducePortions.ts"
  ]
}
